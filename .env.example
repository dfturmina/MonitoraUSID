# ==============================================================================
# MONITORA USID - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para um novo arquivo chamado '.env' na raiz do projeto.
# 2. Preencha os valores reais correspondentes ao seu ambiente (Desenvolvimento/Produção).
# 3. NUNCA comite o arquivo '.env' preenchido no Git (ele é ignorado via .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURAÇÕES DO SERVIDOR & AMBIENTE
# ------------------------------------------------------------------------------
ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. BANCOS DE DADOS
# ------------------------------------------------------------------------------
APP_DB_URL=sqlite+aiosqlite:///data/app.db
POSTGRES_DSN=postgresql+asyncpg://usuario:senha@host:5432/nome_banco
# METABASE_DB_URL=postgresql+asyncpg://usuario:senha@10.34.0.127:5432/metabase

# ------------------------------------------------------------------------------
# 3. AUTENTICAÇÃO CORPORATIVA (ACTIVE DIRECTORY / LDAP)
# ------------------------------------------------------------------------------
# AD_URL=ldap://servidor-ad.ebserhnet.ebserh.gov.br:389
AD_BASEDN="DC=ebserhnet,DC=gov,DC=br"

# ------------------------------------------------------------------------------
# 4. SEGURANÇA E CRIPTOGRAFIA (JWT & COOKIES)
# ------------------------------------------------------------------------------
JWT_SECRET=SUA_CHAVE_SECRETA_SUPER_FORTE_AQUI
JWT_EXP_HOURS=24
REFRESH_TOKEN_EXP_DAYS=30

# ------------------------------------------------------------------------------
# 5. INTEGRAÇÃO REAL COM O ZABBIX HC-UFPE
# ------------------------------------------------------------------------------
ZABBIX_API_URL=http://10.34.0.127/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=seu_token_api_zabbix_aqui

# ------------------------------------------------------------------------------
# 6. ALERTAS MICROSOFT TEAMS (NOTIFICAÇÕES DE QUEDA / RECUPERAÇÃO)
# ------------------------------------------------------------------------------
TEAMS_WEBHOOK_URL=https://sua-url-de-webhook-do-teams-aqui
TEAMS_ALERT_ENABLED=True
TEAMS_CHECK_INTERVAL_SECONDS=60
